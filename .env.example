# Copy to .env.development (local, Neon Local) or .env.production (Neon Cloud).

# ---------- Server ----------
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# ---------- Neon Local (development only) ----------
NEON_API_KEY=
NEON_PROJECT_ID=
# PARENT_BRANCH_ID=

# ---------- Database ----------
# development: postgres://neon:npg@neon-local:5432/neondb   (+ NEON_LOCAL_HOST=neon-local)
# production:  postgresql://<user>:<password>@<endpoint>.neon.tech/<dbname>?sslmode=require
DATABASE_URL=
NEON_LOCAL_HOST=

# ---------- Security ----------
ARCJET_KEY=
